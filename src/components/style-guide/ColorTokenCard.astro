---
export type PreviewType = 'pair' | 'destructive' | 'border' | 'input' | 'ring'

export interface Props {
    token: string
    foregroundToken?: string
    utilities: readonly string[]
    description: string
    previewType: PreviewType
}

const { token, foregroundToken, utilities, description, previewType } =
    Astro.props

const previewForeground = foregroundToken ?? 'foreground'
const variables = [token, foregroundToken].filter(Boolean) as string[]
const modes = [
    { label: 'Light', className: '' },
    { label: 'Dark', className: 'dark' },
] as const
---

<article
    class="overflow-hidden rounded-xl border border-border bg-card text-card-foreground shadow-xs"
    title={description}
>
    <p class="sr-only">{description}</p>
    <div class="grid grid-cols-2 divide-x divide-border border-b border-border">
        {
            modes.map((mode) => (
                <div
                    class:list={[
                        'relative min-h-28 overflow-hidden bg-background text-foreground',
                        mode.className,
                    ]}
                    data-theme-preview={mode.label.toLowerCase()}
                    data-color-tokens={variables.join(',')}
                    data-color-mode={mode.label}
                >
                    <span class="absolute top-3 left-3 z-10 rounded-full border border-border/70 bg-background/85 px-2 py-1 text-[0.625rem] leading-none font-medium text-foreground backdrop-blur-sm">
                        {mode.label}
                    </span>

                    {previewType === 'pair' && (
                        <div
                            class="flex min-h-28 items-center justify-center"
                            style={`background-color: var(--${token}); color: var(--${previewForeground});`}
                        >
                            <span class="text-2xl leading-none font-medium tracking-tight">
                                Aa
                            </span>
                        </div>
                    )}

                    {previewType === 'destructive' && (
                        <div
                            class="flex min-h-28 items-center justify-center"
                            style={`background: color-mix(in oklch, var(--${token}) 12%, var(--background)); color: var(--${token});`}
                        >
                            <span class="text-xs font-medium">Delete</span>
                        </div>
                    )}

                    {previewType === 'border' && (
                        <div class="flex min-h-28 items-center justify-center p-5">
                            <div
                                class="h-14 w-full rounded-lg"
                                style={`border: 2px solid var(--${token}); background: var(--background); color: var(--foreground);`}
                            />
                        </div>
                    )}

                    {previewType === 'input' && (
                        <div class="flex min-h-28 items-center justify-center p-5">
                            <div
                                class="h-10 w-full rounded-md shadow-xs"
                                style={`border: 1px solid var(--${token}); background: var(--background);`}
                            />
                        </div>
                    )}

                    {previewType === 'ring' && (
                        <div class="flex min-h-28 items-center justify-center p-5">
                            <div
                                class="rounded-md border bg-background px-3 py-2 text-xs font-medium text-foreground"
                                style={`border-color: var(--border); box-shadow: 0 0 0 3px color-mix(in oklch, var(--${token}) 45%, transparent);`}
                            >
                                Focus
                            </div>
                        </div>
                    )}
                </div>
            ))
        }
    </div>

    <div class="p-4">
        <p class="truncate text-sm font-medium tracking-tight">
            {token}{foregroundToken && ` / ${foregroundToken}`}
        </p>
        <code
            class="mt-1 block truncate text-[0.6875rem] text-muted-foreground"
        >
            {utilities.join(' ')}
        </code>
    </div>
</article>

<script>
    const resolveColorTokenValues = () => {
        document
            .querySelectorAll<HTMLElement>('[data-color-tokens]')
            .forEach((preview) => {
                const tokens = preview.dataset.colorTokens?.split(',') ?? []
                const values = tokens.map((token) => {
                    const value = getComputedStyle(preview)
                        .getPropertyValue(`--${token}`)
                        .trim()
                    return `--${token}: ${value}`
                })
                const mode = preview.dataset.colorMode ?? 'Theme'
                const metadata = `${mode} — ${values.join('; ')}`

                preview.title = metadata
                preview.setAttribute('aria-label', metadata)
            })
    }

    resolveColorTokenValues()
    document.addEventListener('astro:page-load', resolveColorTokenValues)
</script>
